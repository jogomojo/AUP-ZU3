# AUP-ZU3 EDF (Yocto) build configuration.
#
# Sourced by sdbuild/scripts/build_edf_boot.sh. Names the Yocto machine
# bitbake targets and selects the build mode.

EDF_MANIFEST_TAG=amd-edf-rel-v25.11.1
EDF_MODE=custom
EDF_BOOT_MACHINE=aup-zu3
EDF_LINUX_MACHINE=aup-zu3
EDF_BOARD_DTS=
BSP_XSA_PATH=bsp/bsp.xsa

case "${AUP_ZU3_DDR4_CONFIG:-4}" in
  8) EDF_DDR_HIGH_BANK_REG="0x8 0x0 0x1 0x80000000" ;;
  *) EDF_DDR_HIGH_BANK_REG="0x8 0x0 0x0 0x80000000" ;;
esac
